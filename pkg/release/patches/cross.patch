diff --git a/images/build/cross/default/Dockerfile b/images/build/cross/default/Dockerfile
--- a/images/build/cross/default/Dockerfile
+++ b/images/build/cross/default/Dockerfile
@@ -34,6 +34,9 @@ ENV KUBE_DYNAMIC_CROSSPLATFORMS=${KUBE_DYNAMIC_CROSSPLATFORMS}
 ENV KUBE_CROSSPLATFORMS=${KUBE_CROSSPLATFORMS}
 
 ##------------------------------------------------------------
+
+# Copy precompiled artifacts that are awkward to fetch for riscv64.
+COPY precompiled /precompiled
 COPY --from=go-source /usr/local/go /usr/local/go
 ENV PATH=/usr/local/go/bin:$PATH
 ENV GOROOT=/usr/local/go
@@ -91,17 +94,25 @@ ENV PROTOBUF_VERSION 34.1
 RUN targetArch=$(echo $TARGETPLATFORM | cut -f2 -d '/') \
+  && if [ ${targetArch} = "riscv64" ]; then \
+       apt-get update \
+       && apt-get install -y protobuf-compiler \
+       && protoc --version; \
+     else \
   if [ ${targetArch} = "amd64" ]; then \
   ZIPNAME="protoc-${PROTOBUF_VERSION}-linux-x86_64.zip"; \
 elif [ ${targetArch} = "arm64" ]; then \
   ZIPNAME="protoc-${PROTOBUF_VERSION}-linux-aarch_64.zip"; \
 elif [ ${targetArch} = "ppc64le" ]; then \
   ZIPNAME="protoc-${PROTOBUF_VERSION}-linux-ppcle_64.zip"; \
 elif [ ${targetArch} = "s390x" ]; then \
   ZIPNAME="protoc-${PROTOBUF_VERSION}-linux-s390_64.zip"; \
 fi \
   && mkdir /tmp/protoc && cd /tmp/protoc \
-  && wget "https://github.com/protocolbuffers/protobuf/releases/download/v${PROTOBUF_VERSION}/${ZIPNAME}" \
+  && if [ -f "/precompiled/${ZIPNAME}" ]; then \
+       cp "/precompiled/${ZIPNAME}" .; \
+     else \
+       wget "https://github.com/protocolbuffers/protobuf/releases/download/v${PROTOBUF_VERSION}/${ZIPNAME}"; fi \
   && unzip "${ZIPNAME}" \
   && chmod -R +rX /tmp/protoc \
   && cp -pr bin /usr/local \
   && cp -pr include /usr/local \
   && rm -rf /tmp/protoc \
-  && protoc --version
+  && protoc --version; \
+     fi
