+++ b/images/build/distroless-iptables/distroless-bookworm/Dockerfile
@@ -43,7 +43,15 @@ RUN apt -y update && \

 RUN curl -o "${STAGE_DIR}"/iptables-wrapper-installer.sh https://raw.githubusercontent.com/kubernetes-sigs/iptables-wrappers/v2/iptables-wrapper-installer.sh && \
     chmod +x "${STAGE_DIR}"/iptables-wrapper-installer.sh && \
-    ln -sf /bin/dash "${STAGE_DIR}"/bin/sh
+    ln -sf /bin/dash "${STAGE_DIR}"/bin/sh && \
+    mkdir -p "${STAGE_DIR}"/usr/bin && \
+    cp -a "${STAGE_DIR}"/bin/. "${STAGE_DIR}"/usr/bin/ && \
+    rm -rf "${STAGE_DIR}"/bin && \
+    if [ -d "${STAGE_DIR}"/lib ]; then \
+      mkdir -p "${STAGE_DIR}"/usr/lib && \
+      cp -a "${STAGE_DIR}"/lib/. "${STAGE_DIR}"/usr/lib/ && \
+      rm -rf "${STAGE_DIR}"/lib; \
+    fi

