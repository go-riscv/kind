diff --git a/pkg/cluster/internal/loadbalancer/config.go b/pkg/cluster/internal/loadbalancer/config.go
--- a/pkg/cluster/internal/loadbalancer/config.go
+++ b/pkg/cluster/internal/loadbalancer/config.go
@@ -32,6 +32,42 @@ type ConfigData struct {
 	IPv6             bool
 }

+// HAProxyConfigTemplate is the RISC-V load balancer config template.
+const HAProxyConfigTemplate = `# generated by kind
+global
+  log /dev/log local0
+  log /dev/log local1 notice
+  daemon
+  # limit memory usage to approximately 18 MB
+  maxconn 100000
+
+resolvers docker
+  parse-resolv-conf
+
+defaults
+  log global
+  mode tcp
+  option dontlognull
+  timeout connect 5000
+  timeout client 50000
+  timeout server 50000
+  # allow booting before backend DNS names resolve
+  default-server init-addr none
+
+frontend control-plane
+  bind *:{{ .ControlPlanePort }}
+  {{ if .IPv6 -}}
+  bind :::{{ .ControlPlanePort }};
+  {{- end }}
+  default_backend kube-apiservers
+
+backend kube-apiservers
+  option httpchk GET /healthz
+  {{range $server, $address := .BackendServers}}
+  server {{ $server }} {{ $address }} check check-ssl verify none resolvers docker resolve-prefer {{ if $.IPv6 -}} ipv6 {{- else -}} ipv4 {{- end }}
+  {{- end}}
+`
+
 // DynamicFilesystemConfigTemplate holds the Envoy bootstrap configuration template
 // for file-based dynamic xDS (CDS and LDS).
 // https://www.envoyproxy.io/docs/envoy/latest/start/quick-start/configuration-dynamic-filesystem
diff --git a/pkg/cluster/internal/loadbalancer/const.go b/pkg/cluster/internal/loadbalancer/const.go
--- a/pkg/cluster/internal/loadbalancer/const.go
+++ b/pkg/cluster/internal/loadbalancer/const.go
@@ -16,5 +16,28 @@ limitations under the License.

 package loadbalancer

-// Image defines the loadbalancer image:tag
-const Image = "docker.io/envoyproxy/envoy:v1.36.2"
+import "runtime"
+
+const (
+	// EnvoyImage defines the upstream load balancer image for supported architectures.
+	EnvoyImage = "docker.io/envoyproxy/envoy:v1.36.2"
+	// HAProxyImage defines the RISC-V load balancer image.
+	HAProxyImage = "haproxy:riscv64"
+	// HAProxyConfigPath defines the path to the HAProxy configuration file.
+	HAProxyConfigPath = "/usr/local/etc/haproxy/haproxy.cfg"
+)
+
+// Image defines the architecture-specific load balancer image.
+var Image = imageForArchitecture(runtime.GOARCH)
+
+func imageForArchitecture(arch string) string {
+	if arch == "riscv64" {
+		return HAProxyImage
+	}
+	return EnvoyImage
+}
+
+// UsesHAProxy reports whether this build uses the RISC-V HAProxy path.
+func UsesHAProxy() bool {
+	return runtime.GOARCH == "riscv64"
+}
diff --git a/pkg/cluster/internal/loadbalancer/haproxy_test.go b/pkg/cluster/internal/loadbalancer/haproxy_test.go
new file mode 100644
