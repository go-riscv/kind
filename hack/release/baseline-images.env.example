# Copy to hack/release/baseline-images.env, replace each digest, and keep refs immutable.
# PR no-apt consumer mode rejects mutable tag-only refs.
KUBE_CROSS_BASELINE_IMAGE=ghcr.io/go-riscv/kube-cross-riscv64@sha256:REPLACE_WITH_KUBE_CROSS_DIGEST
DEBIAN_BASE_BASELINE_IMAGE=ghcr.io/go-riscv/debian-base-riscv64@sha256:REPLACE_WITH_DEBIAN_BASE_DIGEST
KUBE_GORUNNER_BASELINE_IMAGE=ghcr.io/go-riscv/go-runner-riscv64@sha256:REPLACE_WITH_GO_RUNNER_DIGEST
KUBE_SETCAP_BASELINE_IMAGE=ghcr.io/go-riscv/setcap-riscv64@sha256:REPLACE_WITH_SETCAP_DIGEST
KUBE_PROXY_BASELINE_IMAGE=ghcr.io/go-riscv/distroless-iptables-riscv64@sha256:REPLACE_WITH_DISTROLESS_IPTABLES_DIGEST
